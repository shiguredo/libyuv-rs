{
  "MD004": {
    "style": "dash",
  },
  "MD013": {
    "line_length": 300,
    "code_blocks": false,
  },
  "MD024": {
    "siblings_only": true,
  },
  // コードブロックやリストで分割された番号付きリストの続き番号 (2. 3. ...) を許容する
  "MD029": false,
  "MD036": false,
  // 日本語文中の乗算・除算記号 (* や _) を強調記法と誤認するため無効化する
  "MD037": false,
  // 行頭空白を表現するコードスパン (コマンド出力の引用など) を許容する
  "MD038": false,
}
